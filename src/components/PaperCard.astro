---
import type { CollectionEntry } from 'astro:content'
import { THEMES } from '../data/themes'
import { href } from '../utils/url'
import { searchText } from '../utils/search'
import { inlineMath } from '../utils/math'

interface Props {
  entry: CollectionEntry<'papers'>
  hasNote: boolean
}

const { entry, hasNote } = Astro.props
const p = entry.data
const theme = THEMES[p.theme]

/** Every card field may carry inline maths and a little inline HTML. */
const m = inlineMath

/** Question, then what it claims, then how it was checked, then what I think. */
const before = [{ label: 'What the paper contributes', items: p.contributions }]
const after = [
  { label: 'Headline results', items: p.results },
  { label: 'My notes', items: p.notes },
  { label: 'Limitations', items: p.limitations }
].filter((f) => f.items.length > 0)
---

<article
  class="card"
  id={entry.id}
  data-theme-key={p.theme}
  data-year={p.year}
  data-text={searchText(p)}
  style={`--h:${theme.hue}`}
>
  <h3 class="card__title">
    {
      p.url ? (
        <a href={p.url} rel="noopener">
          {p.title}
        </a>
      ) : (
        <span class="no-link">{p.title}</span>
      )
    }
  </h3>

  <p class="meta">
    <span class="tag">{theme.label}</span>
    {p.authors && <span>{p.authors}</span>}
    <span class="sep">·</span>
    <span>{p.year}</span>
    {
      p.venue && (
        <>
          <span class="sep">·</span>
          <span>{p.venue}</span>
        </>
      )
    }
    {
      p.code && (
        <>
          <span class="sep">·</span>
          <a href={p.code} rel="noopener">
            code
          </a>
        </>
      )
    }
  </p>

  <p class="why">
    <b>Why it is here</b>
    <Fragment set:html={m(p.why)} />
  </p>

  <details class="card__more">
    <summary>The question, the contribution, my notes</summary>

    <div class="fields">
      <div class="field">
        <h4>The question</h4>
        <p set:html={m(p.question)} />
      </div>

      {
        before.map((f) => (
          <div class="field">
            <h4>{f.label}</h4>
            <ul>
              {f.items.map((item) => (
                <li set:html={m(item)} />
              ))}
            </ul>
          </div>
        ))
      }

      {
        p.evaluation && (
          <div class="field">
            <h4>How it was tested</h4>
            <p set:html={m(p.evaluation)} />
          </div>
        )
      }

      {
        after.map((f) => (
          <div class="field">
            <h4>{f.label}</h4>
            <ul>
              {f.items.map((item) => (
                <li set:html={m(item)} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      hasNote && (
        <a class="card__link" href={href(`papers/${entry.id}`)}>
          Read the full note &rarr;
        </a>
      )
    }
  </details>
</article>
