---
import type { CollectionEntry } from 'astro:content'
import { THEMES } from '../data/themes'
import { href } from '../utils/url'
import { searchText } from '../utils/search'
import { inlineMath } from '../utils/math'
import PaperFields from './PaperFields.astro'

interface Props {
  entry: CollectionEntry<'papers'>
  hasNote: boolean
}

const { entry, hasNote } = Astro.props
const p = entry.data
const theme = THEMES[p.theme]
---

<article
  class="card"
  id={entry.id}
  data-theme-key={p.theme}
  data-year={p.year}
  data-text={searchText(p, entry.body)}
  style={`--h:${theme.hue}`}
>
  <h3 class="card__title">
    {
      p.url ? (
        <a href={p.url} rel="noopener">
          {p.title}
        </a>
      ) : (
        <span class="no-link">{p.title}</span>
      )
    }
  </h3>

  <p class="meta">
    <span class="tag">{theme.label}</span>
    {p.authors && <span>{p.authors}</span>}
    <span class="sep">·</span>
    <span>{p.year}</span>
    {
      p.venue && (
        <>
          <span class="sep">·</span>
          <span>{p.venue}</span>
        </>
      )
    }
    {
      p.code && (
        <>
          <span class="sep">·</span>
          <a href={p.code} rel="noopener">
            code
          </a>
        </>
      )
    }
  </p>

  <p class="why">
    <b>Why it is here</b>
    <Fragment set:html={inlineMath(p.why)} />
  </p>

  <details class="card__more">
    <summary>The question and what it contributes</summary>

    <PaperFields data={p} />

    {
      hasNote && (
        <a class="card__link" href={href(`papers/${entry.id}`)}>
          Read the full note &rarr;
        </a>
      )
    }
  </details>
</article>
