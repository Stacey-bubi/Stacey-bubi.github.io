---
import Base from '../../layouts/Base.astro'
import { href } from '../../utils/url'

const title = 'Research'
const description =
  'A small study I have run myself on refusal directions in language models.'

const posts = [
  {
    slug: 'refusal-ablation',
    title: 'Replicating and Extending the Refusal Direction',
    lede: 'A Graded Ablation Study on Qwen2.5',
    status: 'finished',
    summary:
      'Refusal is gone well before the direction is fully removed, and removing more after that changes nothing. Removing only part of it damages the model more than removing all of it.'
  }
]
---

<Base title={title} description={description}>
  <div class="wrap intro">
    <h1>Research</h1>
    <p>
      A small study I have run myself on how fragile refusal is in open chat
      models. Difference-in-means and forward hooks, no training.
    </p>
  </div>

  <div class="wrap">
    <div class="cards">
      {
        posts.map((p) => (
          <article class="card" style="--h:200">
            <h3 class="card__title">
              <a href={href(`research/${p.slug}`)}>{p.title}</a>
            </h3>
            <p class="meta">
              <span class="tag">{p.status}</span>
              <span class="sep">·</span>
              <span>{p.lede}</span>
            </p>
            <p class="why">
              <b>What came out of it</b>
              {p.summary}
            </p>
            <a class="card__link" href={href(`research/${p.slug}`)}>
              Read it &rarr;
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Base>
