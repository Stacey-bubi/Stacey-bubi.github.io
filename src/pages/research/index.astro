---
import Base from '../../layouts/Base.astro'
import { href } from '../../utils/url'

const title = 'Research'
const description =
  'A small study I have run myself on refusal directions in language models.'

const posts = [
  {
    slug: 'refusal-ablation',
    title: 'How hard do you have to push to break refusal?',
    lede: 'Replicating Arditi et al. on Qwen2.5, then turning the knob down.',
    status: 'finished',
    summary:
      'The single-direction result reproduces on Qwen2.5-7B and 14B. Putting a scaling knob on the ablation shows it is a soft switch, not a dimmer: refusal is gone well before full ablation, and partial ablation damages the model more than full ablation does.'
  }
]
---

<Base title={title} description={description}>
  <div class="wrap intro">
    <h1>Research</h1>
    <p>
      A small study I have run myself on how fragile refusal is in open chat
      models. Difference-in-means and forward hooks, no training.
    </p>
  </div>

  <div class="wrap">
    <div class="cards">
      {
        posts.map((p) => (
          <article class="card" style="--h:200">
            <h3 class="card__title">
              <a href={href(`research/${p.slug}`)}>{p.title}</a>
            </h3>
            <p class="meta">
              <span class="tag">{p.status}</span>
              <span class="sep">·</span>
              <span>{p.lede}</span>
            </p>
            <p class="why">
              <b>What came out of it</b>
              {p.summary}
            </p>
            <a class="card__link" href={href(`research/${p.slug}`)}>
              Read it &rarr;
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Base>
